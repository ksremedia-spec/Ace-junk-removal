// Ace's sync server. Runs locally with `npm run dev` (no Cloudflare account
// needed); `database_id` is filled in when it is first deployed.
{
  "name": "ace-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ace-sync",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
